# CybLight Login - Environment Configuration Example

# API base URL
VITE_API_BASE=https://api.cyblight.org

# Turnstile CAPTCHA
VITE_TURNSTILE_SITEKEY=0x4AAAAAACIMk1fcGPcs3NLf

# Feature flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true

# Development settings
VITE_LOG_LEVEL=debug
VITE_API_TIMEOUT_MS=10000

# Google Drive backup (OAuth 2.0 Web client ID from Google Cloud Console)
# Enable Google Drive API, scope drive.file, authorized origins: login.cyblight.org, http://localhost:3000
# Scopes also need drive.metadata.readonly + drive.readonly (see README) for cross-platform backup
VITE_GOOGLE_DRIVE_CLIENT_ID=apps.googleusercontent.com

# ==============================================================================
# Paddle Payment Configuration
# ==============================================================================
# Environment: 'production' (live) or 'sandbox'
# WARNING: Never leave this unset - the app will fail loudly if missing to prevent running against the wrong account.
VITE_PADDLE_ENVIRONMENT=production

# Paddle Client-Side Token (must start with 'live_' on production or 'test_' on sandbox)
# Generated in Paddle Dashboard > Developer Tools > Authentication > Client-side tokens
VITE_PADDLE_CLIENT_TOKEN=live_your_paddle_client_token_here

# (Optional) Configurable Paddle Price IDs
VITE_PADDLE_PRICE_STARTER_MONTH=pri_starter_month_id
VITE_PADDLE_PRICE_STARTER_YEAR=pri_starter_year_id
VITE_PADDLE_PRICE_PRO_MONTH=pri_pro_month_id
VITE_PADDLE_PRICE_PRO_YEAR=pri_pro_year_id
VITE_PADDLE_PRICE_ADVANCED_MONTH=pri_advanced_month_id
VITE_PADDLE_PRICE_ADVANCED_YEAR=pri_advanced_year_id
